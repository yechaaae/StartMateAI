# Local mock mode is useful while the hackathon GMS request format is unknown.
USE_MOCK_LLM=true

# RAG retrieval mode: keyword, vector, or hybrid.
# hybrid = vector similarity + policy eligibility scoring.
RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_STORE_PATH=.rag_index/support_programs.vector.json
SUPPORT_RAG_EMBEDDING_DIMENSIONS=384
SUPPORT_RAG_CHROMA_ENABLED=true
SUPPORT_RAG_CHROMA_PATH=.chroma
SUPPORT_RAG_CHROMA_COLLECTION=support_programs
RAG_CHROMA_PATH=.chroma
RAG_EMBEDDING_DIMENSIONS=3072
RAG_EMBEDDING_PROVIDER=openai

# Law Open API OC value from https://open.law.go.kr.
# Needed by scripts/collect_legal_sources.py for LegalAgent RAG ingestion.
LAW_OPEN_API_OC=

# Fill these when the GMS API contract is confirmed.
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com
GMS_CHAT_PATH=/v1/chat/completions
GMS_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com
OPENAI_EMBEDDING_PATH=/v1/embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# GMS OpenAI-compatible examples use Authorization: Bearer.
GMS_API_KEY_HEADER=Authorization
GMS_API_KEY_QUERY_PARAM=
GMS_AUTH_SCHEME=Bearer
GMS_TIMEOUT_SECONDS=30

# RabbitMQ worker mode. Used by `python -m app.rabbitmq_worker`.
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=startmate
SPRING_RABBITMQ_PASSWORD=startmate
STARTMATE_AI_CHAT_REQUEST_QUEUE=chat.request
STARTMATE_AI_CHAT_RESPONSE_QUEUE=chat.response

# Backend internal tools. The token must match backend STARTMATE_INTERNAL_TOOL_TOKEN.
BACKEND_INTERNAL_BASE_URL=http://backend:8080
STARTMATE_INTERNAL_TOOL_TOKEN=startmate-local-internal-token
BACKEND_TOOL_TIMEOUT_SECONDS=10

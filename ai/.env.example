# Local mock mode is useful while the hackathon GMS request format is unknown.
USE_MOCK_LLM=true

# RAG retrieval mode: keyword, vector, or hybrid.
# hybrid = vector similarity + policy eligibility scoring.
RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_STORE_PATH=.rag_index/support_programs.vector.json
RAG_EMBEDDING_DIMENSIONS=384

# Law Open API OC value from https://open.law.go.kr.
# Needed by scripts/collect_legal_sources.py for LegalAgent RAG ingestion.
LAW_OPEN_API_OC=

# Fill these when the GMS API contract is confirmed.
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com
GMS_CHAT_PATH=/v1beta/models/gemini-2.5-flash:generateContent
GMS_MODEL=gemini-2.5-flash

# GMS Gemini examples use x-goog-api-key.
GMS_API_KEY_HEADER=x-goog-api-key
GMS_API_KEY_QUERY_PARAM=
GMS_AUTH_SCHEME=
GMS_TIMEOUT_SECONDS=30
